# Phase 2A AI explanation layer configuration.
# The deterministic provider is the default and needs no credentials.
INTELLIGENCE_PROVIDER=deterministic

# To use a remote LLM (chat-completions API) instead, uncomment and fill in:
# NEVER commit real keys to the repo.
# INTELLIGENCE_PROVIDER=http
# INTELLIGENCE_LLM_ENDPOINT=https://your-llm-host/v1/chat/completions
# INTELLIGENCE_LLM_API_KEY=
# INTELLIGENCE_LLM_MODEL=
